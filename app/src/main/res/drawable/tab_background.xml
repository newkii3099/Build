<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Frosted Glass Card -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FDFEFE"
                android:centerColor="#F5F9FD"
                android:endColor="#EBF4FC" />
            <stroke
                android:width="1.5dp"
                android:color="#8038BDF8" />
        </shape>
    </item>

    <!-- Top Soft Cyan Highlight -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:type="linear"
                android:startColor="#2038BDF8"
                android:endColor="#00000000"
                android:angle="90" />
        </shape>
    </item>
</layer-list>
