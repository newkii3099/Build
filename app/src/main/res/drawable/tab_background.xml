<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#F0091811"
                android:centerColor="#E60A1D14"
                android:endColor="#F2050D09" />
        </shape>
    </item>

    <!-- Top Soft Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:startColor="#2600FFA3"
                android:centerColor="#1000FFA3"
                android:endColor="#00000000"
                android:angle="90" />
        </shape>
    </item>

    <!-- Thin Glass Border -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#4034D399" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
