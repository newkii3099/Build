<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#059669"
                android:centerColor="#047857"
                android:endColor="#065F46"
                android:angle="135" />
            <corners android:radius="40dp" />
            <stroke android:width="1.5dp" android:color="#80FFFFFF" />
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <shape>
            <gradient
                android:startColor="#00FFA3"
                android:centerColor="#10B981"
                android:endColor="#059669"
                android:angle="135" />
            <corners android:radius="40dp" />
            <size android:width="120dp" android:height="44dp" />
            <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
</selector>
