<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3300D4FF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#E61A2050" />
                    <stroke android:width="1.2dp" android:color="#9900D4FF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#CC0F1438" />
                    <stroke android:width="1dp" android:color="#4D8B5CF6" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
