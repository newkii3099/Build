<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#7C3AED"
                android:endColor="#DB2777" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#8B5CF6"
                android:endColor="#EC4899" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#99FFFFFF" />
        </shape>
    </item>
</selector>
