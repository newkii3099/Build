<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🌃 CRYZEN Neon City Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_launcher" />

    <!-- 🌌 Deep Midnight Indigo Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#7306081A" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 🏷️ Top Navigation Bar with Back Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- ⬅️ Back Button -->
                <LinearLayout
                    android:id="@+id/btn_back_to_home"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_action_card"
                    android:clickable="true"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_back"
                        app:tint="#00D4FF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="กลับหน้าหลัก"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:letterSpacing="0.04"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="การตั้งค่าเกม (CRYZEN 2.0)"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Placeholder to balance Back Button -->
                <View
                    android:layout_width="110dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- ⚙️ CARD 1: การตั้งค่าทั่วไป (General Settings)     -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_white"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="การตั้งค่าทั่วไป (General Settings)"
                    android:textColor="#00D4FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 👤 Nickname Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundColor="#CC0F1438"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#00D4FF"
                    app:endIconMode="clear_text"
                    app:endIconTint="#94A3B8"
                    app:hintTextColor="#00D4FF"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="#00D4FF">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settings_nickname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="ชื่อตัวละครในเกม (เช่น CRYZEN_Player)"
                        android:padding="12dp"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ⌨️ Android Keyboard Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_action_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_keyboard"
                        app:tint="#00D4FF" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="ใช้แป้นพิมพ์ Android ปกติ (Android Keyboard)"
                        android:textColor="#F8FAFC"
                        android:textSize="12.5sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/keyboard_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="#00D4FF"
                        app:trackTint="#4D8B5CF6" />
                </LinearLayout>

                <!-- 🎙️ Voice Chat Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_action_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_voice"
                        app:tint="#A78BFA" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="ระบบเสียงพูดคุยในเกม (Voice Chat)"
                        android:textColor="#F8FAFC"
                        android:textSize="12.5sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/voice_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="#00D4FF"
                        app:trackTint="#4D8B5CF6" />
                </LinearLayout>

                <!-- ⚡ FPS Display Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_action_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_fps"
                        app:tint="#EC4899" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="แสดงค่าความลื่นไหล (FPS Counter)"
                        android:textColor="#F8FAFC"
                        android:textSize="12.5sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/fps_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="#00D4FF"
                        app:trackTint="#4D8B5CF6" />
                </LinearLayout>

            </LinearLayout>

            <!-- ============================================== -->
            <!-- 🚀 CARD 2: ประสิทธิภาพ (Performance)           -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_white"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="ประสิทธิภาพและการแสดงผล (Performance)"
                    android:textColor="#00D4FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- FPS Limit Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_action_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_speed"
                            app:tint="#00D4FF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="จำกัดอัตราเฟรมเรต (FPS Limit)"
                            android:textColor="#F8FAFC"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/fps_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_purple"
                            android:fontFamily="sans-serif-bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="60"
                            android:textColor="#00D4FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/fps_seekbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="3"
                        android:progress="1"
                        android:progressTint="#00D4FF"
                        android:splitTrack="false"
                        android:thumbTint="#EC4899" />
                </LinearLayout>

                <!-- Message Count Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_action_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_message"
                            app:tint="#A78BFA" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="จำนวนบรรทัดข้อความแชท (Chat Lines)"
                            android:textColor="#F8FAFC"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/messages_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_purple"
                            android:fontFamily="sans-serif-bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="6"
                            android:textColor="#00D4FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/messages_seekbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="3"
                        android:progress="1"
                        android:progressTint="#00D4FF"
                        android:splitTrack="false"
                        android:thumbTint="#EC4899" />
                </LinearLayout>

            </LinearLayout>

            <!-- 🔄 Reinstall Cache Button -->
            <LinearLayout
                android:id="@+id/btn_reinstall_cache"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_action_card"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="🔄 ตรวจสอบและดาวน์โหลดไฟล์แคชเกมใหม่ (Reinstall Cache)"
                    android:textColor="#EC4899"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Placeholder Space -->
            <View
                android:id="@+id/placeholderSpace"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
