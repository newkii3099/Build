<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gamehud"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- 🌟 Main Floating Glass HUD Card (Top Right) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hudMainCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_glass_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 💵 Money & Weapon Section (Row 1) -->
        <LinearLayout
            android:id="@+id/moneyContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Cash Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView6"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="5dp"
                    app:tint="@color/mint_accent"
                    app:srcCompat="@drawable/wallet" />

                <TextView
                    android:id="@+id/money_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="$ 999,999,999"
                    android:textColor="@color/mint_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bank Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/banklogot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="5dp"
                    app:tint="#A7F3D0"
                    app:srcCompat="@drawable/bank" />

                <TextView
                    android:id="@+id/bank_money_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="$ 999,999,999"
                    android:textColor="#E0FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 🔫 Weapon & Ammo Pod -->
        <LinearLayout
            android:id="@+id/weaponContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/moneyContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/moneyContainer">

            <ImageView
                android:id="@+id/hud_weapon"
                android:layout_width="32dp"
                android:layout_height="22dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/weapon_0" />

            <TextView
                android:id="@+id/weapon_ammo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="1000 / 1000"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- 📊 Status Gauges (Row 2: HP, Armour, Food, Drink) -->
        <LinearLayout
            android:id="@+id/progressContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/moneyContainer">

            <!-- HP -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="26dp"
                android:layout_height="26dp">

                <com.kurdish.roleplay.launcher.util.SeekArc
                    android:id="@+id/hud_progress_hp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:padding="2dp"
                    app:arcColor="#26FFFFFF"
                    app:arcWidth="2dp"
                    app:enabled="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:progress="360"
                    app:progressColor="#00FFA3"
                    app:progressWidth="2.5dp" />

                <ImageView
                    android:id="@+id/icon_hp"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/health"
                    app:layout_constraintBottom_toBottomOf="@id/hud_progress_hp"
                    app:layout_constraintEnd_toEndOf="@id/hud_progress_hp"
                    app:layout_constraintStart_toStartOf="@id/hud_progress_hp"
                    app:layout_constraintTop_toTopOf="@id/hud_progress_hp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="0dp" />

            <!-- ARMOUR -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="26dp"
                android:layout_height="26dp">

                <com.kurdish.roleplay.launcher.util.SeekArc
                    android:id="@+id/hud_progress_shp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:padding="2dp"
                    app:arcColor="#26FFFFFF"
                    app:arcWidth="2dp"
                    app:enabled="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:progress="360"
                    app:progressColor="#38BDF8"
                    app:progressWidth="2.5dp" />

                <ImageView
                    android:id="@+id/icon_armour"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/armour"
                    app:layout_constraintBottom_toBottomOf="@id/hud_progress_shp"
                    app:layout_constraintEnd_toEndOf="@id/hud_progress_shp"
                    app:layout_constraintStart_toStartOf="@id/hud_progress_shp"
                    app:layout_constraintTop_toTopOf="@id/hud_progress_shp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="0dp" />

            <!-- FOOD / EAT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="26dp"
                android:layout_height="26dp">

                <com.kurdish.roleplay.launcher.util.SeekArc
                    android:id="@+id/hud_progress_eat"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:padding="2dp"
                    app:arcColor="#26FFFFFF"
                    app:arcWidth="2dp"
                    app:enabled="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:progress="360"
                    app:progressColor="#FBBF24"
                    app:progressWidth="2.5dp" />

                <ImageView
                    android:id="@+id/icon_eat"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/satiety"
                    app:layout_constraintBottom_toBottomOf="@id/hud_progress_eat"
                    app:layout_constraintEnd_toEndOf="@id/hud_progress_eat"
                    app:layout_constraintStart_toStartOf="@id/hud_progress_eat"
                    app:layout_constraintTop_toTopOf="@id/hud_progress_eat" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="0dp" />

            <!-- DRINK / THIRST -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="26dp"
                android:layout_height="26dp">

                <com.kurdish.roleplay.launcher.util.SeekArc
                    android:id="@+id/hud_progress_drink"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:padding="2dp"
                    app:arcColor="#26FFFFFF"
                    app:arcWidth="2dp"
                    app:enabled="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:progress="360"
                    app:progressColor="#3B82F6"
                    app:progressWidth="2.5dp" />

                <ImageView
                    android:id="@+id/icon_drink"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/drink"
                    app:layout_constraintBottom_toBottomOf="@id/hud_progress_drink"
                    app:layout_constraintEnd_toEndOf="@id/hud_progress_drink"
                    app:layout_constraintStart_toStartOf="@id/hud_progress_drink"
                    app:layout_constraintTop_toTopOf="@id/hud_progress_drink" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- ℹ️ Info Strip (Row 3: Time, Online, ID) -->
        <LinearLayout
            android:id="@+id/infoStrip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/bg_glass_pill"
            android:paddingVertical="3dp"
            android:paddingHorizontal="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressContainer">

            <ImageView
                android:id="@+id/icon_time"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="3dp"
                app:tint="#FFFFFF"
                app:srcCompat="@drawable/time" />

            <TextView
                android:id="@+id/realTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="12:00"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginHorizontal="6dp"
                android:background="#33FFFFFF" />

            <ImageView
                android:id="@+id/icon_players"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="3dp"
                app:tint="@color/mint_accent"
                app:srcCompat="@drawable/players" />

            <TextView
                android:id="@+id/textPlayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="1"
                android:textColor="@color/mint_accent"
                android:textSize="9sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginHorizontal="6dp"
                android:background="#33FFFFFF" />

            <ImageView
                android:id="@+id/playerid"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="2dp"
                app:tint="#A7F3D0"
                app:srcCompat="@drawable/hash" />

            <TextView
                android:id="@+id/yourid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="0"
                android:textColor="#A7F3D0"
                android:textSize="9sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 📷 Modern Floating Camera View Button -->
    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hudMainCard">

        <ImageView
            android:id="@+id/hud_camera"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/camera_butt"
            app:tint="@color/mint_accent" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
