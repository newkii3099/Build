<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_modern"
    android:keepScreenOn="true">

    <!-- 🔹 Header (Logo + Brand Name) -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_app_logo"
            android:elevation="6dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAMP MOBILE"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT-GEN MULTIPLAYER"
                android:textColor="@color/mint_accent"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15" />
        </LinearLayout>
    </LinearLayout>

    <!-- 🌐 Live Server Info Card (Glassmorphism) -->
    <LinearLayout
        android:id="@+id/serverInfoCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Status Dot -->
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/indicator_circle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ONLINE"
            android:textColor="@color/mint_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-bold"
            android:layout_marginEnd="12dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginEnd="12dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="141.95.234.17:1417"
            android:textColor="#E0FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- 🔸 Center Content / Actions -->
    <LinearLayout
        android:id="@+id/bottomInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/serverInfoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/placeholderSpace">

        <!-- ▶️ Play Button (Vibrant Mint Pill) -->
        <FrameLayout
            android:id="@+id/btnPlay"
            android:layout_width="150dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_play_modern"
            android:clickable="true"
            android:focusable="true"
            android:elevation="8dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAY NOW"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>
        </FrameLayout>

        <!-- 🌐 Social Icons in Glass Capsule -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/discordBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/social_icon_bg"
                android:padding="5dp"
                android:src="@drawable/discord_logo" />

            <ImageView
                android:id="@+id/webBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/social_icon_bg"
                android:padding="5dp"
                android:src="@drawable/internet" />

            <ImageView
                android:id="@+id/youtubeBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/social_icon_bg"
                android:padding="5dp"
                android:src="@drawable/youtube_logo" />
        </LinearLayout>

        <!-- 🧾 Version Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_pill"
            android:text="v2.11.311 · 64-bit ARM"
            android:textColor="@color/mint_soft"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- ⚫ Placeholder Space for Bottom Navigation -->
    <View
        android:id="@+id/placeholderSpace"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@android:color/transparent" />

</androidx.constraintlayout.widget.ConstraintLayout>
