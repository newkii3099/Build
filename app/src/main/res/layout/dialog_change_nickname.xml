<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80050714"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card_white"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Dialog Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_person"
                app:tint="#00D4FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="เปลี่ยนชื่อตัวละคร (Nickname)"
                android:textColor="#F8FAFC"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/dialogNickCloseBtn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/hud_icon_close"
                app:tint="#E2E8F0" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="14dp"
            android:background="#2600D4FF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:text="ชื่อนี้จะถูกใช้เพื่อบันทึกข้อมูลตัวละครและเชื่อมต่อเข้าเซิร์ฟเวอร์ CRYZEN CITY 2.0 (รองรับตัวอักษรภาษาอังกฤษ ตัวเลข และเครื่องหมาย _)"
            android:textColor="#C7D2FE"
            android:textSize="11.5sp" />

        <!-- Input Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_action_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_person"
                app:tint="#00D4FF" />

            <EditText
                android:id="@+id/etDialogNickname"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:hint="กรอกชื่อตัวละคร (เช่น CRYZEN_Player)"
                android:inputType="textPersonName|textNoSuggestions"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDialogNickCancel"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_action_card"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="16dp"
                android:text="ยกเลิก"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDialogNickSave"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_action_hero"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="20dp"
                android:text="บันทึกชื่อ"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
