<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_nextcity_logo" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="ต้องการสิทธิ์เข้าถึงข้อมูล"
            android:textColor="@color/nextcity_text_title"
            android:textSize="15.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="3dp"
        android:text="เพื่อดาวน์โหลดและอัปเดตไฟล์ข้อมูลเกม NextCity SAMP ให้สมบูรณ์ โปรดอนุญาตการเข้าถึงพื้นที่จัดเก็บข้อมูลของอุปกรณ์"
        android:textColor="@color/nextcity_text_body"
        android:textSize="12.5sp"
        android:layout_marginBottom="18dp" />

    <Button
        android:id="@+id/btnAllow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_action_hero"
        android:fontFamily="sans-serif-bold"
        android:text="อนุญาตสิทธิ์และเข้าเล่น"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
