<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_inventory_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#73000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- 🌟 Glassmorphism Main Card Dialog -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_inventory_main"
        android:layout_width="560dp"
        android:layout_height="295dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_inv_glass_container"
        android:padding="10dp">

        <!-- 🔹 Header Section -->
        <ImageView
            android:id="@+id/iv_inv_title_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_inv_bag"
            app:layout_constraintBottom_toBottomOf="@id/tv_inv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_inv_title"
            app:tint="#38BDF8" />

        <TextView
            android:id="@+id/tv_inv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/prompt_regular"
            android:text="กระเป๋าสัมภาระ (INVENTORY)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/iv_inv_title_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_inv_capacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_inv_badge"
            android:fontFamily="@font/prompt_regular"
            android:text="0 / 30 ช่อง"
            android:textColor="#34D399"
            android:textSize="9.5sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_inv_title"
            app:layout_constraintStart_toEndOf="@id/tv_inv_title"
            app:layout_constraintTop_toTopOf="@id/tv_inv_title" />

        <ImageView
            android:id="@+id/btn_close_inv"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/hud_icon_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#94A3B8" />

        <!-- 🔹 Top Separator Line -->
        <View
            android:id="@+id/line_header_sep"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#26FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_inv_title" />

        <!-- 🔹 Left Column: Vertical Hotbar 1–7 -->
        <LinearLayout
            android:id="@+id/layout_hotbar_column"
            android:layout_width="48dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line_header_sep">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:fontFamily="@font/prompt_regular"
                android:text="คีย์ลัด 1-7"
                android:textColor="#38BDF8"
                android:textSize="8sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/container_hotbar_slots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/hotbar_slot_0"
                        layout="@layout/item_hotbar_slot" />

                    <include
                        android:id="@+id/hotbar_slot_1"
                        layout="@layout/item_hotbar_slot" />

                    <include
                        android:id="@+id/hotbar_slot_2"
                        layout="@layout/item_hotbar_slot" />

                    <include
                        android:id="@+id/hotbar_slot_3"
                        layout="@layout/item_hotbar_slot" />

                    <include
                        android:id="@+id/hotbar_slot_4"
                        layout="@layout/item_hotbar_slot" />

                    <include
                        android:id="@+id/hotbar_slot_5"
                        layout="@layout/item_hotbar_slot" />

                    <include
                        android:id="@+id/hotbar_slot_6"
                        layout="@layout/item_hotbar_slot" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- 🔹 Vertical Separator Line -->
        <View
            android:id="@+id/line_column_sep"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:background="#26FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/layout_hotbar_column"
            app:layout_constraintTop_toBottomOf="@id/line_header_sep" />

        <!-- 🔹 Right Column: Smooth Scrollable Inventory Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_inv_grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:fadeScrollbars="false"
            android:paddingBottom="6dp"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/line_column_sep"
            app:layout_constraintTop_toBottomOf="@id/line_header_sep" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
