<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayoutContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🌃 CRYZEN Neon City Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_launcher" />

    <!-- 🌌 Deep Midnight Indigo Scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6606081A" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 🏷️ Transparent CRYZEN CITY 2.0 Logo at Top Center -->
        <LinearLayout
            android:id="@+id/loadingHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="210dp"
                android:layout_height="80dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_app_logo" />
        </LinearLayout>

        <!-- 📦 Cyber-Glass Progress Card -->
        <LinearLayout
            android:id="@+id/progressCard"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="18dp"
            app:layout_constraintBottom_toTopOf="@id/versionContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loadingHeader">

            <!-- Header inside Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/loadingIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_loading"
                    app:tint="#00D4FF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="กำลังเชื่อมต่อเข้าสู่เมือง..."
                    android:textColor="#F8FAFC"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/progressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_purple"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="0%"
                    android:textColor="#00D4FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cryzen Neon Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBarr"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:indeterminateOnly="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/custom_progress" />

            <!-- Status Subtext -->
            <TextView
                android:id="@+id/loadingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="กำลังเตรียมความพร้อมของเมือง CRYZEN CITY 2.0..."
                android:textColor="#C7D2FE"
                android:textSize="11sp" />

            <!-- Animated Loading Dots -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_circle_red" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_circle_red" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_circle_red" />
            </LinearLayout>

        </LinearLayout>

        <!-- 🧾 Version Info at Bottom -->
        <LinearLayout
            android:id="@+id/versionContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_status"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="CRYZEN CITY 2.0"
                android:textColor="#00D4FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginHorizontal="8dp"
                android:background="#40FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v2.0.2-cryzen"
                android:textColor="#E2E8F0"
                android:textSize="10sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
