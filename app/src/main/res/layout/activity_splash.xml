<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🌅 Anime Coastal City Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_launcher" />

    <!-- 🌌 Dark Translucent Vignette -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gpu"
            android:layout_width="1dp"
            android:layout_height="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 📦 Modern Center Welcome Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#F8FAFC"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingVertical="24dp">

                <!-- App Logo -->
                <ImageView
                    android:id="@+id/appLogo"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/ic_nextcity_logo"
                    android:elevation="4dp" />

                <!-- App Name -->
                <LinearLayout
                    android:id="@+id/appNameLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.06"
                        android:text="NEXTCITY"
                        android:textColor="@color/nextcity_text_title"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.18"
                        android:text="PLAY • CONNECT • ENJOY"
                        android:textColor="#7C3AED"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Thai Tagline -->
                <TextView
                    android:id="@+id/taglineText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="ยินดีต้อนรับสู่โลกเสมือนจริง NextCity SAMP"
                    android:textColor="@color/nextcity_text_body"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Loading Animation Area -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/loadingIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_loading"
                        app:tint="#7C3AED" />

                    <TextView
                        android:id="@+id/checkingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="กำลังตรวจสอบข้อมูลและเตรียมระบบ..."
                        android:textColor="@color/nextcity_text_muted"
                        android:textSize="11.5sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Version Pill at Bottom -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_status"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="เวอร์ชัน 2.11.313 (64-bit ARM)"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
